\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Schematic $(L,W,D)$ tradeoff across barrier regimes. Here $W$ counts identification operations, including a constant-time tag read, so the nominal zero-error point sits at $W=O(1)$ rather than $W=0$. The left orange point shows the collision-free attribute-only regime ($A_\pi =1$), while the red point shows a colliding attribute-only regime with $D>0$. Nominal tagging is the unique zero-error Pareto point in maximal-barrier domains.}}{8}{figure.100}\protected@file@percent }
\newlabel{fig:lwd-tradeoff}{{1}{8}{Schematic $(L,W,D)$ tradeoff across barrier regimes. Here $W$ counts identification operations, including a constant-time tag read, so the nominal zero-error point sits at $W=O(1)$ rather than $W=0$. The left orange point shows the collision-free attribute-only regime ($A_\pi =1$), while the red point shows a colliding attribute-only regime with $D>0$. Nominal tagging is the unique zero-error Pareto point in maximal-barrier domains}{figure.100}{}}
