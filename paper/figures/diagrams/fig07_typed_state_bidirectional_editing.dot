digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    margin=0.12,
    pad=0.18,
    nodesep=0.48,
    ranksep=0.72,
    color="transparent",
    pencolor="transparent",
    penwidth=0,
    fontname="Helvetica"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=14,
    color="#263238",
    penwidth=1.3,
    fillcolor="#FAFAFA"
  ];
  edge [
    color="#546E7A",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Helvetica",
    fontsize=11
  ];

  label=<
    <B>Figure 7. Typed state keeps GUI, code, and runtime synchronized</B>
  >;
  labelloc=t;
  fontsize=20;

  subgraph cluster_surfaces {
    label="Editing surfaces";
    style="rounded,filled";
    color="#D9E4EC";
    fillcolor="#F7FAFC";

    gui [label=<
      <B>GUI</B><BR ALIGN="LEFT"/>
      parameter forms<BR ALIGN="LEFT"/>
      inheritance previews<BR ALIGN="LEFT"/>
      live / saved state
    >, fillcolor="#E3F2FD"];
    code [label=<
      <B>Generated Python</B><BR ALIGN="LEFT"/>
      editable source<BR ALIGN="LEFT"/>
      version control<BR ALIGN="LEFT"/>
      re-importable workflow
    >, fillcolor="#FFF8E1"];
    llm [label=<
      <B>LLM / assistant</B><BR ALIGN="LEFT"/>
      actual callable registry<BR ALIGN="LEFT"/>
      type signatures<BR ALIGN="LEFT"/>
      constrained generation
    >, fillcolor="#F3E5F5"];
  }

  state [label=<
    <B>ObjectState</B><BR ALIGN="LEFT"/>
    typed values<BR ALIGN="LEFT"/>
    inheritance<BR ALIGN="LEFT"/>
    provenance<BR ALIGN="LEFT"/>
    dirty tracking<BR ALIGN="LEFT"/>
    code generation
  >, fillcolor="#E0F2F1", color="#00796B", penwidth=2.2];

  scope [label=<
    <B>Resolution scopes</B><BR ALIGN="LEFT"/>
    global defaults<BR ALIGN="LEFT"/>
    pipeline overrides<BR ALIGN="LEFT"/>
    step overrides<BR ALIGN="LEFT"/>
    function invocation values
  >, fillcolor="#E8F5E9", color="#2E7D32"];

  runtime [label=<
    <B>Compiled runtime context</B><BR ALIGN="LEFT"/>
    resolved values<BR ALIGN="LEFT"/>
    function parameters<BR ALIGN="LEFT"/>
    worker-safe execution plan
  >, fillcolor="#E8EAF6", color="#283593", penwidth=2.0];

  change_audit [label=<
    <B>Inspectable change</B><BR ALIGN="LEFT"/>
    local / inherited / defaulted<BR ALIGN="LEFT"/>
    source of value<BR ALIGN="LEFT"/>
    generated code diff<BR ALIGN="LEFT"/>
    reproducible rerun
  >, fillcolor="#FFF3E0", color="#E65100"];

  gui -> state [label="edit"];
  code -> state [label="parse"];
  llm -> state [label="construct"];
  state -> scope [label="resolve"];
  scope -> runtime [label="compile"];
  state -> change_audit [label="provenance"];
  change_audit -> gui [label="display"];
  change_audit -> code [label="serialize"];
}
