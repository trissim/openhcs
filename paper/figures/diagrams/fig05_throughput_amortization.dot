digraph G {
  graph [
    rankdir=LR,
    bgcolor="white",
    margin=0.12,
    pad=0.18,
    nodesep=0.48,
    ranksep=0.65,
    color="transparent",
    pencolor="transparent",
    penwidth=0,
    fontname="Helvetica"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=14,
    color="#263238",
    penwidth=1.3,
    fillcolor="#FAFAFA"
  ];
  edge [
    color="#546E7A",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Helvetica",
    fontsize=11
  ];

  label=<
    <B>Figure 5. Many-well HCS amortizes fixed worker costs</B>
  >;
  labelloc=t;
  fontsize=20;

  fixed [label=<
    <B>Fixed worker costs</B><BR ALIGN="LEFT"/>
    Python import<BR ALIGN="LEFT"/>
    backend imports<BR ALIGN="LEFT"/>
    pipeline compile<BR ALIGN="LEFT"/>
    Numba / OpenCV warmup<BR ALIGN="LEFT"/>
    worker setup
  >, fillcolor="#FFF3E0", color="#E65100"];

  variable [label=<
    <B>Per-sample costs</B><BR ALIGN="LEFT"/>
    module execution<BR ALIGN="LEFT"/>
    image I/O<BR ALIGN="LEFT"/>
    artifact output<BR ALIGN="LEFT"/>
    measurement tables
  >, fillcolor="#E8F5E9", color="#2E7D32"];

  samples [label=<
    <B>Samples per worker</B><BR ALIGN="LEFT"/>
    1 sample: worst amortization<BR ALIGN="LEFT"/>
    16-24 samples: HCS-like<BR ALIGN="LEFT"/>
    persistent workers reuse state
  >, fillcolor="#E3F2FD", color="#1565C0"];

  formula [label=<
    <B>Effective seconds per sample</B><BR ALIGN="LEFT"/>
    (startup + compile + warmup)<BR ALIGN="LEFT"/>
    / samples_per_worker<BR ALIGN="LEFT"/>
    + execution<BR ALIGN="LEFT"/>
    + output
  >, fillcolor="#F3E5F5", color="#6A1B9A", penwidth=2.0];

  ram [label=<
    <B>RAM constraint</B><BR ALIGN="LEFT"/>
    libraries<BR ALIGN="LEFT"/>
    compiled kernels<BR ALIGN="LEFT"/>
    stores<BR ALIGN="LEFT"/>
    cached arrays<BR ALIGN="LEFT"/>
    intermediate outputs
  >, fillcolor="#ECEFF1", color="#455A64"];

  capacity [label=<
    <B>Capacity curve</B><BR ALIGN="LEFT"/>
    workers<BR ALIGN="LEFT"/>
    samples / hour<BR ALIGN="LEFT"/>
    peak RAM<BR ALIGN="LEFT"/>
    RAM per worker<BR ALIGN="LEFT"/>
    speedup vs CP
  >, fillcolor="#E0F2F1", color="#00796B", penwidth=2.0];

  fixed -> formula [label="amortized"];
  samples -> formula [label="denominator"];
  variable -> formula [label="added per sample"];
  formula -> capacity [label="throughput"];
  ram -> capacity [label="feasible worker count"];
}
