digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    margin=0.12,
    pad=0.18,
    nodesep=0.45,
    ranksep=0.55,
    color="transparent",
    pencolor="transparent",
    penwidth=0,
    fontname="Helvetica"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=14,
    color="#263238",
    penwidth=1.3,
    fillcolor="#FAFAFA"
  ];
  edge [
    color="#546E7A",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Helvetica",
    fontsize=11
  ];

  label=<
    <B>Figure 6. Backend acceleration is selected by contracts</B>
  >;
  labelloc=t;
  fontsize=20;

  workflow [label=<
    <B>Workflow semantics</B><BR ALIGN="LEFT"/>
    source schema<BR ALIGN="LEFT"/>
    dimensions<BR ALIGN="LEFT"/>
    objects / measurements<BR ALIGN="LEFT"/>
    materialized outputs
  >, fillcolor="#E3F2FD", color="#1565C0", penwidth=2.0];

  contract [label=<
    <B>Function memory contract</B><BR ALIGN="LEFT"/>
    @numpy<BR ALIGN="LEFT"/>
    @cupy<BR ALIGN="LEFT"/>
    @jax<BR ALIGN="LEFT"/>
    @torch / @tensorflow<BR ALIGN="LEFT"/>
    @pyclesperanto
  >, fillcolor="#FFF8E1", color="#F9A825"];

  compiler [label=<
    <B>Compiler selection</B><BR ALIGN="LEFT"/>
    validate semantics<BR ALIGN="LEFT"/>
    choose compatible callable<BR ALIGN="LEFT"/>
    preserve artifact contract<BR ALIGN="LEFT"/>
    prepare warmup hooks
  >, fillcolor="#E0F2F1", color="#00796B", penwidth=2.0];

  subgraph cluster_backends {
    label="Backend variants";
    style="rounded,filled";
    color="#D9E4EC";
    fillcolor="#F7FAFC";

    numpy [label=<
      <B>NumPy / Numba</B><BR/>
      CPU parity default
    >, fillcolor="#E8F5E9"];
    cupy [label=<
      <B>CuPy / CuCIM</B><BR/>
      NumPy-like GPU paths
    >, fillcolor="#F3E5F5"];
    cle [label=<
      <B>pyclesperanto</B><BR/>
      OpenCL image kernels
    >, fillcolor="#FFF3E0"];
    jax [label=<
      <B>JAX</B><BR/>
      dense pure kernels
    >, fillcolor="#E8EAF6"];
    dl [label=<
      <B>PyTorch / TensorFlow</B><BR/>
      model inference
    >, fillcolor="#FCE4EC"];
  }

  arraybridge [label=<
    <B>ArrayBridge</B><BR ALIGN="LEFT"/>
    explicit conversion<BR ALIGN="LEFT"/>
    memory-type awareness<BR ALIGN="LEFT"/>
    backend boundary visible
  >, fillcolor="#ECEFF1", color="#455A64"];

  parity [label=<
    <B>Same parity policy</B><BR ALIGN="LEFT"/>
    dtype behavior<BR ALIGN="LEFT"/>
    boundary behavior<BR ALIGN="LEFT"/>
    label semantics<BR ALIGN="LEFT"/>
    reductions
  >, fillcolor="#E8EAF6", color="#283593", penwidth=2.0];

  workflow -> contract;
  contract -> compiler;
  compiler -> numpy;
  compiler -> cupy;
  compiler -> cle;
  compiler -> jax;
  compiler -> dl;
  numpy -> arraybridge;
  cupy -> arraybridge;
  cle -> arraybridge;
  jax -> arraybridge;
  dl -> arraybridge;
  arraybridge -> parity [label="outputs compared under same semantics"];
}
