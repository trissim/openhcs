digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    margin=0.12,
    pad=0.18,
    nodesep=0.55,
    ranksep=0.55,
    color="transparent",
    pencolor="transparent",
    penwidth=0,
    fontname="Helvetica"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=14,
    color="#263238",
    penwidth=1.3,
    fillcolor="#FAFAFA"
  ];
  edge [
    color="#546E7A",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Helvetica",
    fontsize=11
  ];

  label=<
    <B>Figure 2. Compile-then-execute architecture</B>
  >;
  labelloc=t;
  fontsize=20;

  subgraph cluster_inputs {
    label="Editable inputs";
    style="rounded,filled";
    color="#D9E4EC";
    fillcolor="#F7FAFC";

    source [label=<
      <B>Source schema</B><BR/>
      wells, sites, channels,<BR/>
      time, z, metadata
    >, fillcolor="#E3F2FD"];
    state [label=<
      <B>Typed state</B><BR/>
      global / pipeline / step<BR/>
      inheritance and overrides
    >, fillcolor="#E8F5E9"];
    funcs [label=<
      <B>Function registry</B><BR/>
      memory decorators<BR/>
      signatures<BR/>
      processing contracts
    >, fillcolor="#FFF8E1"];
    cppipe [label=<
      <B>CellProfiler dialect</B><BR/>
      modules and settings<BR/>
      source binding<BR/>
      measurement semantics
    >, fillcolor="#FFF3E0"];
  }

  compiler [label=<
    <B>OpenHCS compiler</B><BR ALIGN="LEFT"/>
    path planning<BR ALIGN="LEFT"/>
    source binding<BR ALIGN="LEFT"/>
    dimensional validation<BR ALIGN="LEFT"/>
    memory contract validation<BR ALIGN="LEFT"/>
    runtime artifact planning<BR ALIGN="LEFT"/>
    materialization planning
  >, fillcolor="#E0F2F1", color="#00796B", penwidth=2.3];

  subgraph cluster_plan {
    label="Compiled runtime plan";
    style="rounded,filled";
    color="#D9E4EC";
    fillcolor="#FBFCFD";

    steps [label=<
      <B>FunctionSteps</B><BR/>
      one function or chain<BR/>
      typed invocation context
    >, fillcolor="#F1F8E9"];
    artifacts [label=<
      <B>Runtime artifacts</B><BR/>
      images, labels, tables,<BR/>
      relationships, grids,<BR/>
      materialized files
    >, fillcolor="#FCE4EC"];
    stores [label=<
      <B>Storage plan</B><BR/>
      memory, disk, Zarr,<BR/>
      napari, Fiji
    >, fillcolor="#EDE7F6"];
  }

  subgraph cluster_execution {
    label="Execution backends";
    style="rounded,filled";
    color="#D9E4EC";
    fillcolor="#F7FAFC";

    arraybridge [label=<
      <B>ArrayBridge</B><BR/>
      NumPy, CuPy, JAX,<BR/>
      PyTorch, TensorFlow,<BR/>
      pyclesperanto
    >, fillcolor="#F3E5F5"];
    workers [label=<
      <B>ZMQRuntime workers</B><BR/>
      persistent processes<BR/>
      progress streaming<BR/>
      viewer isolation
    >, fillcolor="#E0F7FA"];
    outputs [label=<
      <B>Outputs</B><BR/>
      parity reports<BR/>
      figures / CSVs<BR/>
      viewer streams
    >, fillcolor="#E8F5E9"];
  }

  source -> compiler;
  state -> compiler;
  funcs -> compiler;
  cppipe -> compiler;

  compiler -> steps;
  compiler -> artifacts;
  compiler -> stores;

  steps -> arraybridge [label="memory conversion"];
  steps -> workers [label="submitted plan"];
  artifacts -> stores [label="materialize"];
  stores -> outputs [label="write / stream"];
  workers -> outputs [label="run"];
  arraybridge -> workers [label="backend-compatible arrays"];
}
