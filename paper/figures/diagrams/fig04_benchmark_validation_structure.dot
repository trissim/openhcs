digraph G {
  graph [
    rankdir=TB,
    bgcolor="white",
    margin=0.12,
    pad=0.18,
    nodesep=0.5,
    ranksep=0.5,
    color="transparent",
    pencolor="transparent",
    penwidth=0,
    fontname="Helvetica"
  ];
  node [
    shape=rect,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=14,
    color="#263238",
    penwidth=1.3,
    fillcolor="#FAFAFA"
  ];
  edge [
    color="#546E7A",
    penwidth=1.6,
    arrowsize=0.75,
    fontname="Helvetica",
    fontsize=11
  ];

  label=<
    <B>Figure 4. Benchmark structure separates parity, speed, and throughput</B>
  >;
  labelloc=t;
  fontsize=20;

  manifest [label=<
    <B>Benchmark manifest</B><BR ALIGN="LEFT"/>
    .cppipe path<BR ALIGN="LEFT"/>
    dataset source<BR ALIGN="LEFT"/>
    source category<BR ALIGN="LEFT"/>
    assay family<BR ALIGN="LEFT"/>
    semantic pressure
  >, fillcolor="#E3F2FD", color="#1565C0"];

  cp_run [label=<
    <B>Native CellProfiler</B><BR ALIGN="LEFT"/>
    reference execution<BR ALIGN="LEFT"/>
    output tables<BR ALIGN="LEFT"/>
    labels / images<BR ALIGN="LEFT"/>
    materialized files
  >, fillcolor="#FFF3E0", color="#E65100"];

  oh_run [label=<
    <B>OpenHCS import + run</B><BR ALIGN="LEFT"/>
    same .cppipe<BR ALIGN="LEFT"/>
    same dataset<BR ALIGN="LEFT"/>
    compiled artifacts<BR ALIGN="LEFT"/>
    one-core condition
  >, fillcolor="#E0F2F1", color="#00796B"];

  parity [label=<
    <B>Semantic parity</B><BR ALIGN="LEFT"/>
    measurements<BR ALIGN="LEFT"/>
    labels / objects<BR ALIGN="LEFT"/>
    image values<BR ALIGN="LEFT"/>
    relationships<BR ALIGN="LEFT"/>
    declared tolerances
  >, fillcolor="#E8EAF6", color="#283593", penwidth=2.0];

  timing [label=<
    <B>Timing split</B><BR ALIGN="LEFT"/>
    startup<BR ALIGN="LEFT"/>
    compile<BR ALIGN="LEFT"/>
    warmup<BR ALIGN="LEFT"/>
    execution<BR ALIGN="LEFT"/>
    output
  >, fillcolor="#F3E5F5", color="#6A1B9A"];

  report [label=<
    <B>Benchmark report</B><BR ALIGN="LEFT"/>
    pass / fail parity<BR ALIGN="LEFT"/>
    raw seconds<BR ALIGN="LEFT"/>
    speedup vs CP<BR ALIGN="LEFT"/>
    RAM<BR ALIGN="LEFT"/>
    category summaries
  >, fillcolor="#E8F5E9", color="#2E7D32", penwidth=2.0];

  throughput [label=<
    <B>Throughput layer</B><BR ALIGN="LEFT"/>
    many wells<BR ALIGN="LEFT"/>
    persistent workers<BR ALIGN="LEFT"/>
    samples per worker<BR ALIGN="LEFT"/>
    RAM per worker
  >, fillcolor="#FFFDE7", color="#F9A825"];

  manifest -> cp_run [label="reference"];
  manifest -> oh_run [label="import"];
  cp_run -> parity [label="expected outputs"];
  oh_run -> parity [label="observed outputs"];
  oh_run -> timing [label="phase timings"];
  parity -> report;
  timing -> report;
  manifest -> throughput;
  throughput -> report;
}
