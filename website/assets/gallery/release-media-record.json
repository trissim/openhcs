  "website_provenance_html": "        <aside class=\"gallery-provenance\" aria-label=\"Gallery dataset provenance\">\n          <span>Dataset note</span>\n          <p>\n            CellProfiler ExampleCometAssay and ExampleWoundHealing are shown under BSD-3-Clause. Comet fluorescence images were contributed by Scott Floyd and Michael Pacold.\n            <a href=\"https://github.com/CellProfiler/examples/tree/4972b59e670a4ae96c3d453803c92eeff378d054\">Source and attribution</a>.\n            The gallery media have a\n            <a href=\"assets/gallery/release-media-record.json\">capture and checksum record</a>.\n          </p>\n        </aside>",
  "website_cards": [
    {
      "id": "multi-plate-overview",
      "rendered_html": "          <figure class=\"gallery-card gallery-card-wide\">\n            <a\n              class=\"gallery-media-link\"\n              href=\"assets/gallery/multi-plate-overview.webp\"\n              aria-label=\"Open the multi-plate workspace screenshot at full resolution\"\n            >\n              <img\n                src=\"assets/gallery/multi-plate-overview.webp\"\n                width=\"1600\"\n                height=\"958\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                alt=\"OpenHCS Plate Manager with seven assay plates loaded, including CellProfiler Comet Assay and Wound Healing examples\"\n              >\n            </a>\n            <figcaption>\n              <span class=\"gallery-label\">Workspace</span>\n              <h3>Seven assay plates, one workspace</h3>\n              <p>Five deterministic examples and two imported CellProfiler workflows retain independent state in one session.</p>\n            </figcaption>\n          </figure>"
    },
    {
      "id": "pipeline-editor",
      "rendered_html": "          <figure class=\"gallery-card gallery-card-compact\">\n            <a\n              class=\"gallery-media-link\"\n              href=\"assets/gallery/pipeline-editor.webp\"\n              aria-label=\"Open the pipeline editor screenshot at full resolution\"\n            >\n              <img\n                src=\"assets/gallery/pipeline-editor.webp\"\n                width=\"942\"\n                height=\"900\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                alt=\"OpenHCS Pipeline Editor showing the 12 imported steps of the CellProfiler Comet Assay\"\n              >\n            </a>\n            <figcaption>\n              <span class=\"gallery-label\">Authoring</span>\n              <h3>CellProfiler steps in the same pipeline model</h3>\n              <p>The 12-step Comet Assay uses OpenHCS compilation, configuration, viewers, and results.</p>\n            </figcaption>\n          </figure>"
    },
    {
      "id": "lazy-inheritance",
      "rendered_html": "          <figure class=\"gallery-card gallery-card-motion gallery-card-wide\">\n            <div class=\"gallery-motion\">\n              <video\n                controls\n                muted\n                loop\n                playsinline\n                preload=\"metadata\"\n                poster=\"assets/gallery/lazy-inheritance-poster.webp\"\n                aria-describedby=\"lazy-inheritance-caption\"\n              >\n                <source src=\"assets/gallery/lazy-inheritance.webm\" type=\"video/webm\">\n                <source src=\"assets/gallery/lazy-inheritance.mp4\" type=\"video/mp4\">\n                <a href=\"assets/gallery/lazy-inheritance.mp4\">Download the lazy-inheritance demonstration.</a>\n              </video>\n              <a\n                class=\"gallery-motion-fallback gallery-media-link\"\n                href=\"assets/gallery/lazy-inheritance-poster.webp\"\n                aria-label=\"Open the lazy-inheritance demonstration poster at full resolution\"\n              >\n                <img\n                  src=\"assets/gallery/lazy-inheritance-poster.webp\"\n                  width=\"1600\"\n                  height=\"1000\"\n                  loading=\"lazy\"\n                  decoding=\"async\"\n                  alt=\"OpenHCS workspace beside pipeline and step settings showing Well Filter Image30 at pipeline scope and inherited by the step\"\n                >\n                <span>Static view shown because reduced motion is enabled</span>\n              </a>\n            </div>\n            <figcaption id=\"lazy-inheritance-caption\">\n              <span class=\"gallery-label\">Configuration</span>\n              <h3>See configuration provenance in both directions</h3>\n              <p>Well Filter changes to Image30 in PipelineConfig, then the inherited step field flashes as the update arrives. Clicking that step label flashes the owning PipelineConfig field, making the provenance link explicit in both directions.</p>\n            </figcaption>\n          </figure>"
    },
    {
      "id": "fiji-review",
      "rendered_html": "          <figure class=\"gallery-card gallery-card-compact\">\n            <a\n              class=\"gallery-media-link\"\n              href=\"assets/gallery/fiji-review.webp\"\n              aria-label=\"Open the Fiji integration screenshot at full resolution\"\n            >\n              <img\n                src=\"assets/gallery/fiji-review.webp\"\n                width=\"1310\"\n                height=\"930\"\n                loading=\"lazy\"\n                decoding=\"async\"\n                alt=\"Fiji ImageJ showing one NeuronCyto II Field 1 nuclear plane with its nine native segmentation ROI entries\"\n              >\n            </a>\n            <figcaption>\n              <span class=\"gallery-label\">Fiji</span>\n              <h3>Review matching ROIs in Fiji</h3>\n              <p>OpenHCS streams one bound Field 1 nuclear plane and its nine segmentation ROIs together. The native outlines follow the displayed nuclei.</p>\n            </figcaption>\n          </figure>"
    },
    {
      "id": "zmq-startup-compile",
      "rendered_html": "          <figure class=\"gallery-card gallery-card-motion gallery-card-feature\">\n            <div class=\"gallery-motion\">\n              <video\n                controls\n                muted\n                loop\n                playsinline\n                preload=\"metadata\"\n                poster=\"assets/gallery/zmq-startup-compile-poster.webp\"\n                aria-describedby=\"zmq-startup-compile-caption\"\n              >\n                <source src=\"assets/gallery/zmq-startup-compile.webm\" type=\"video/webm\">\n                <source src=\"assets/gallery/zmq-startup-compile.mp4\" type=\"video/mp4\">\n                <a href=\"assets/gallery/zmq-startup-compile.mp4\">Download the endpoint-startup recording.</a>\n              </video>\n              <a\n                class=\"gallery-motion-fallback gallery-media-link\"\n                href=\"assets/gallery/zmq-startup-compile-poster.webp\"\n                aria-label=\"Open the execution-endpoint startup poster at full resolution\"\n              >\n                <img\n                  src=\"assets/gallery/zmq-startup-compile-poster.webp\"\n                  width=\"1600\"\n                  height=\"1000\"\n                  loading=\"lazy\"\n                  decoding=\"async\"\n                  alt=\"OpenHCS showing an execution endpoint preparing its function catalog while a pipeline compiles\"\n                >\n                <span>Static view shown because reduced motion is enabled</span>\n              </a>\n            </div>\n            <figcaption id=\"zmq-startup-compile-caption\">\n              <span class=\"gallery-label\">Local MCP</span>\n              <h3>See endpoint startup while the request is running</h3>\n              <p>A pointer-free MCP compile request immediately adds the execution endpoint, streams catalog-preparation phases into the browser and status bar, and settles connected.</p>\n            </figcaption>\n          </figure>"
    },
    {
      "id": "napari-roi-navigation",
      "rendered_html": "          <figure class=\"gallery-card gallery-card-motion gallery-card-feature\">\n            <div class=\"gallery-motion\">\n              <video\n                controls\n                muted\n                loop\n                playsinline\n                preload=\"metadata\"\n                poster=\"assets/gallery/napari-roi-navigation-poster.webp\"\n                aria-describedby=\"napari-roi-navigation-caption\"\n              >\n                <source src=\"assets/gallery/napari-roi-navigation.webm\" type=\"video/webm\">\n                <source src=\"assets/gallery/napari-roi-navigation.mp4\" type=\"video/mp4\">\n                <a href=\"assets/gallery/napari-roi-navigation.mp4\">Download the Napari ROI-navigation recording.</a>\n              </video>\n              <a\n                class=\"gallery-motion-fallback gallery-media-link\"\n                href=\"assets/gallery/napari-roi-navigation-poster.webp\"\n                aria-label=\"Open the Napari ROI-navigation poster at full resolution\"\n              >\n                <img\n                  src=\"assets/gallery/napari-roi-navigation-poster.webp\"\n                  width=\"1600\"\n                  height=\"896\"\n                  loading=\"lazy\"\n                  decoding=\"async\"\n                  alt=\"Napari showing segmented nuclei, a selected native ROI, its measurement row, and the current Z plane\"\n                >\n                <span>Static view shown because reduced motion is enabled</span>\n              </a>\n            </div>\n            <figcaption id=\"napari-roi-navigation-caption\">\n              <span class=\"gallery-label\">Napari</span>\n              <h3>ROI selection navigates the Z stack</h3>\n              <p>A pointer-free MCP sequence selects measurement rows across a three-plane result. Napari scrolls the table, highlights the native ROI, and moves from Z 3/3 to Z 1/3 and back.</p>\n            </figcaption>\n          </figure>"
